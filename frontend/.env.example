# Backend API Endpoint
# Next.js akan mem-proxy seluruh request browser (/api/*) ke URL target di bawah ini.
#
# Pilihan 1: Langsung ke Ingress Staging Kubernetes (membutuhkan koneksi Tailscale aktif)
NEXT_PUBLIC_API_URL=http://staging.100.79.211.49.nip.io

# Pilihan 2: Ke localhost (jika menggunakan `kubectl port-forward svc/backend-service 8080:80 -n staging` atau go run lokal)
# NEXT_PUBLIC_API_URL=http://localhost:8080

