meta {
  name: User - Login
  type: http
  seq: 1
}

post {
  url: {{url}}auth/signin/credential
  body: json
  auth: none
}

headers {
  Origin: {{url}}
}

body:json {
  {
    "credential": "kenan@example.com",
    "password": "Rahasia123!"
  }
}

script:post-response {
  let token = res.getHeader("set-auth-token");
  if (token) {
    bru.setEnvVar("token", token);
  }
  
}
