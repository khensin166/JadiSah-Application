meta {
  name: Change Password
  type: http
  seq: 7
}

post {
  url: {{url}}/api/auth/passwords/change
  body: json
  auth: bearer
}

headers {
  Origin: {{url}}
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "current_password": "OldPassword123!",
    "new_password": "NewPassword123!",
    "revoke_other_sessions": true
  }
}
